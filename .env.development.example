# shipyard DEV/test 環境変数テンプレート (CF-20260527-013 env 分離原則)
# このファイルはコミット可。.env.development.local (gitignored) にコピーして DEV/test 実値を設定。
#
# Next.js の env 読み込み順 (priority 高→低):
#   1. .env.<environment>.local  (例: .env.development.local = `next dev` 自動 load)
#   2. .env.<environment>
#   3. .env.local
#   4. .env
#
# env 分離原則 (CF-20260527-013):
# - .env.development.local = DEV/test キー (このファイル) — `next dev` 限定、本番には反映しない
# - .env.production.local  = 本番 (live) キー単一 source — Vercel prod env 同期用 (release scaffold §3.1c)
# - .env.local             = (任意) 両モード共通の補助。本 PJ では使わない
#
# = ローカル開発 (DEV) と本番 (live) を物理的に分離。混ぜない。
# 本 PJ は無課金 LP のため Stripe live 化不要、Clerk は §3.2 サブドメ確定後に production instance 切替判断。

# --- Site (DEV) ---
SITE_URL=http://localhost:3000

# --- DB (Neon、無課金 Free 枠) ---
# 取得: console.neon.tech → プロジェクト作成 → Connection string (Pooled 推奨)
# 本 PJ は本番一本化モデルなので、初回は本番用 Neon project を 1 つ作って DEV/PROD 同じ DATABASE_URL を使う案も可。
# 分離するなら Neon の dev branch を使う (1 project 内で別 branch、無料枠内)。
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# --- Auth (Clerk dev instance) — admin/operator のみ ---
# 取得: dashboard.clerk.com → API Keys (dev instance、`*.accounts.dev`)
# 本番ドメイン未確定なので Phase 1 は dev instance のみ (CF-20260528-005)。
# production instance 切替は §3.2 サブドメ確定後。
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
OPERATOR_EMAILS=seiji@example.com

# --- Email (Resend) ---
# Resend は test/live 区別なし、1 アカウントで free 3000 通/月
RESEND_API_KEY=re_xxx
MAIL_FROM=onboarding@resend.dev  # DEV では Resend の sandbox から (本番では verified domain)
OPERATOR_EMAIL=seiji@example.com

# --- Spam (Cloudflare Turnstile) ---
# 取得: dash.cloudflare.com → Turnstile → サイト作成 (DEV 用 site key)
# 1.1.1.1 (always-pass) key も使える: SITE=1x00000000000000000000AA / SECRET=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- HUB status ([論点-001] contract 確定後、DEV はモック可) ---
HUB_STATUS_URL=https://hub-stub.example.com/api/public/status

# --- Cron (Vercel Cron、DEV では使わない) ---
CRON_SECRET=dev-cron-secret-not-for-production

# --- Monitoring (DEV では空でも OK) ---
SENTRY_DSN=

# --- コスト単価 (無料枠は 0) ---
COST_RESEND_PER_EMAIL=0
COST_VERCEL_BANDWIDTH_PER_GB=0
COST_NEON_STORAGE_PER_GB_PER_MONTH=0
