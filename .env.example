# shipyard 環境変数 (docs/PREREQUISITES.md 参照)
# .env.local にコピーして実値を設定。.env*.local は .gitignore 済 (秘密はコミットしない、O25)

# --- Site ---
SITE_URL=https://shipyard.example.com

# --- DB (Neon, _shared/db) ---
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# --- Auth (Clerk, _shared/auth) — operator/admin のみ ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
OPERATOR_EMAILS=seiji@example.com

# --- Email (Resend, _shared/email) ---
RESEND_API_KEY=re_xxx
MAIL_FROM=shipyard@example.com
OPERATOR_EMAIL=seiji@example.com

# --- Spam (Cloudflare Turnstile, _shared/spam) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA_xxx
TURNSTILE_SECRET_KEY=0x4AAAAAAA_secret

# --- HUB status (service-hub, _shared/hub-client) — [論点-001] 確定後 ---
HUB_STATUS_URL=https://hub.example.com/api/public/status
# HUB_STATUS_API_KEY=  # 任意 (HUB 側方針次第)

# --- HUB service-info (O48 v2, service-hub が pull する shipyard 自身の指標) ---
# 全サービス共通シークレット 1 本 (旧 HUB_SHARED_SECRET / per-service token は廃止)
HUB_SERVICE_INFO_SECRET=change-me  # GET /api/hub/service-info の Bearer 認証用

# --- Cron (service-status) ---
CRON_SECRET=change-me

# --- Monitoring (Sentry) ---
SENTRY_DSN=

# --- コスト単価 (.env で管理, concept §4.6.2、無料枠内は 0) ---
COST_RESEND_PER_EMAIL=0
COST_VERCEL_BANDWIDTH_PER_GB=0
COST_NEON_STORAGE_PER_GB_PER_MONTH=0
