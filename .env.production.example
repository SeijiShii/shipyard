# shipyard 本番環境変数テンプレート (release.md §3.1c CF-20260528-008 標準 scaffold)
# このファイルはコミット可。.env.production.local (gitignored) にコピーして実値を設定。
#
# 運用契約:
# - .env.production.local = 本番値の単一 source (人間が値を貼る、gitignored)
# - scripts/sync-prod-env.sh が deploy-target (Vercel) 永続 env に同期
# - scripts/deploy-prod.sh が sync → deploy
# - GUI 手入力 (vercel dashboard でペタペタ) は人為ミス源、スクリプト経由で同期
#
# 取得手順は docs/PREREQUISITES.md / ~/.claude/flow-data/env-acquisition-guide.md 参照

# --- Site (本 PJ の公開 URL、concept §4.7 サブドメ運用) ---
SITE_URL=https://shipyard.example.com

# --- DB (Neon, _shared/db) ---
# 取得: console.neon.tech → プロジェクト → Connection string (pooled 推奨)
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# --- Auth (Clerk, _shared/auth) — operator/admin のみ ---
# 取得: dashboard.clerk.com → API Keys
# 初回は dev/test キー (pk_test_/sk_test_) で OK。本格運用は production instance (pk_live_/sk_live_) へ差し替え
# Clerk production instance 作成にはアプリ本番ドメイン (DNS 制御) が前提 (CF-20260528-005)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace
CLERK_SECRET_KEY=sk_test_replace
OPERATOR_EMAILS=seiji@example.com

# --- Email (Resend, _shared/email) ---
# 取得: resend.com/api-keys → Create API key
# MAIL_FROM は Resend で verify したドメインの送信元
RESEND_API_KEY=re_replace
MAIL_FROM=noreply@example.com
OPERATOR_EMAIL=seiji@example.com

# --- Spam (Cloudflare Turnstile, _shared/spam) ---
# 取得: dash.cloudflare.com → Turnstile → サイト作成 (本番ドメイン登録)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA_replace
TURNSTILE_SECRET_KEY=0x4AAAAAAA_secret_replace

# --- HUB status (service-hub, _shared/hub-client) — [論点-001] contract 確定後 ---
HUB_STATUS_URL=https://hub.example.com/api/public/status
# HUB_STATUS_API_KEY=  # 任意 (HUB 側方針次第)
# STATUS_REFRESH_TTL_SEC=3600  # 任意。read-through refresh の鮮度 TTL 秒 (既定 3600 = 1時間、revise C20260608-001)

# --- Cron (service-status 定期取得) ---
# openssl rand -hex 32 で生成
CRON_SECRET=replace-with-openssl-rand-hex-32

# --- Monitoring (Sentry、本番のみ任意) ---
# 取得: sentry.io → プロジェクト → Client Keys (DSN)
SENTRY_DSN=

# --- コスト単価 (.env で管理, concept §4.6.2、無料枠内は 0) ---
COST_RESEND_PER_EMAIL=0
COST_VERCEL_BANDWIDTH_PER_GB=0
COST_NEON_STORAGE_PER_GB_PER_MONTH=0
