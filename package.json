{
  "name": "shipyard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "vitest run --dir test/smoke",
    "db:generate": "bash scripts/with-env.sh drizzle-kit generate",
    "db:migrate": "bash scripts/with-env.sh drizzle-kit migrate",
    "db:reset": "bash scripts/with-env.sh drizzle-kit drop && bash scripts/with-env.sh drizzle-kit migrate",
    "e2e": "bash scripts/with-env.sh playwright test"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.9.0",
    "@neondatabase/serverless": "^0.10.4",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.469.0",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^4.0.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.6",
    "@playwright/test": "^1.49.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.6",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
